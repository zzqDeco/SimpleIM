# Template for /srv/simpleim/config/production.env (mode 0600, owned by simpleim-deploy).
# Never commit real production secrets to Git.

# Public HTTPS site address & port.
# - Shared Aliyun ECS alongside teamie (:443): SITE_ADDRESS=https://YOUR_PUBLIC_IP:8444,
#   TLS_SERVER_NAME=YOUR_PUBLIC_IP, TLS_CONFIG_FILE=/srv/simpleim/current/deploy/tls/certificate-files.caddy,
#   TLS_CERT_DIR=/srv/simpleim/tls
# - Dedicated domain (:443 or :8444): SITE_ADDRESS=https://im.example.com:8444, TLS_SERVER_NAME=im.example.com
PUBLIC_HTTPS_PORT=8444
CADDY_HTTPS_PORT=8444
SITE_ADDRESS=https://im.example.com:8444
TLS_SERVER_NAME=im.example.com
TLS_CONFIG_FILE=./tls/acme-domain.caddy
TLS_CERT_DIR=./tls

# Strict CORS / CSRF origin allowlist enforced by apps/server
ALLOWED_ORIGINS=https://im.example.com:8444

# Persistent Ed25519 root signing key (32-byte Base64URL without padding).
# Generate once on the host:
#   openssl rand 32 | base64 | tr '+/' '-_' | tr -d '='
SERVER_KEY_ID=srvk_2026_01
SERVER_IDENTITY_PRIVATE_KEY=REPLACE_WITH_32_BYTE_BASE64URL_ED25519_SEED

# Optional container image overrides (production releases inject immutable digests via images.env)
CADDY_IMAGE=caddy:2.11.7-alpine
SERVER_IMAGE=simpleim-server:latest
WEB_IMAGE=simpleim-web:latest
COTURN_IMAGE=coturn/coturn:4.6-alpine

# Optional self-hosted Coturn STUN + ephemeral HMAC-SHA1 TURN relay
ENABLE_COTURN=false
STUN_URLS=
COTURN_URLS=
COTURN_SHARED_SECRET=
COTURN_CONFIG_FILE=./turnserver.conf.example
